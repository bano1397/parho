# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_MESSAGING_SENDER_ID=
VITE_FB_APP_ID=
# App Check → Fraud Defense (reCAPTCHA Enterprise) site key
VITE_RECAPTCHA_SITE_KEY=
# Local dev only: register this in App Check → Apps → Manage debug tokens
VITE_APPCHECK_DEBUG_TOKEN=
